INSTALL_JDK_VERSION=17
INSTALL_ANDROID_SDK_VERSION=36.0.0
INSTALL_ANDROID_TOOLS_VERSION=15859902
INSTALL_NODE_VERSION=26

# Don't change these values unless you know what you're doing
WORKSPACE=/workspace
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ANDROID_HOME=/workspace/android-sdk
ANDROID_SDK_ROOT=/workspace/android-sdk
ANDROID_TOOLS=/workspace/android-sdk/cmdline-tools/bin
CORDOVA_PATH=/workspace/node_modules/cordova/bin